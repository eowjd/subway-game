  const msg=document.createElement('div');
  msg.className='tag-sound-msg';
  msg.textContent='삑 · 환승입니다';
  reader.appendChild(msg);
}
function playTagSound(){
  showTagMessage();
  playTagBeep();
  setTimeout(playTransferVoice,80);
}


