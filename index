function renderScene(st){
  const topRow=$('seat-top-row');
  const botRow=$('seat-bottom-row');
  topRow.innerHTML='';
  botRow.innerHTML='';
  const displayIds=DISPLAY_PER_STATION[st.name];
  const displayPersons=displayIds.map(id=>PERSONS.find(p=>p.id===id));

  displayPersons.forEach((p,i)=>{
    const slot=document.createElement('div');
    slot.className='pax-slot'; slot.dataset.id=p.id;
    slot.innerHTML=`
      <img class="img-top"   src="${BASE}${p.top}${V}"   alt="${p.name}">
      <img class="img-front" src="${BASE}${p.front}${V}" alt="${p.name}">
      <div class="sel-badge"><svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg></div>
    `;
    slot.addEventListener('mouseenter',()=>{
      const prompt=$('obs-st').parentElement;
      $('sc-obs').querySelector('.obs-prompt').classList.add('peek-mode');
      prompt.lastChild.textContent=' 하차 승객을 슬쩍 확인 중';
    });
    slot.addEventListener('mouseleave',()=>{
      const prompt=$('obs-st').parentElement;
      $('sc-obs').querySelector('.obs-prompt').classList.remove('peek-mode');
      prompt.lastChild.textContent=' 하차 승객을 관찰해 선택하세요';
    });
    slot.addEventListener('click',()=>{
      if(selected.has(p.id)){selected.delete(p.id);slot.classList.remove('selected');}
      else{selected.add(p.id);slot.classList.add('selected');}
      $('obs-btn').disabled=selected.size===0;
      $('obs-btn').classList.toggle('on',selected.size>0);
    });
    if(i<4) topRow.appendChild(slot);
    else botRow.appendChild(slot);
  });
}

// 제출
$('obs-btn').addEventListener('click',()=>{
  if($('obs-btn').disabled)return;
  const st=STATIONS[gameIdx];
  const correct=new Set(st.correctIds);
  const selArr=[...selected];
  const hit=selArr.filter(id=>correct.has(id)).length;
  const bad=selArr.filter(id=>!correct.has(id)).length;
  const miss=[...correct].filter(id=>!selected.has(id));
  const ok=hit===correct.size&&bad===0;
  if(ok){wins++;stationResults[st.name]='success';}
  else{stationResults[st.name]='fail';if(!firstFail)firstFail=st.name;}
  renderResult(ok,hit,bad,miss,correct,selArr,st);
});

