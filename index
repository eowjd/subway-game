    </div>
    <div class="res-texts">
      <div class="res-title" style="color:${ok?'#22c55e':'#ef4444'}">${ok?'자리 확보 성공!':'자리 선점 실패'}</div>
      <div class="res-sub">${st.name}역 · 정답 ${correct.size}명</div>
      <div class="res-comment">${resultComment}</div>
      <div class="res-meta">
        <span class="meta-pill">관찰 난이도 ${meta.difficulty}</span>
        <span class="meta-pill">생활권 단서 ${meta.tags.slice(0,2).join(' · ')}</span>
      </div>
      <div class="res-nums">
        <div class="rn"><span class="rn-v" style="color:#22c55e">${hit}</span><span class="rn-l">정답</span></div>
        <div class="rn"><span class="rn-v" style="color:#f59e0b">${miss.length}</span><span class="rn-l">놓침</span></div>
        <div class="rn"><span class="rn-v" style="color:#ef4444">${bad}</span><span class="rn-l">오선택</span></div>
      </div>
    </div>
  `;

  // 바디
  const body=$('res-body'); body.innerHTML='';

  // 역 특성
  const stCard=document.createElement('div'); stCard.className='station-card';
  stCard.innerHTML=`<div class="station-name">${st.name}역</div><div class="station-desc">${st.stationDesc}</div><div class="station-tags">${(STATION_META[st.name]?.tags||[]).map(t=>`<span class="station-tag">${t}</span>`).join('')}</div>`;
  body.appendChild(stCard);

  // 이 역에서 내린 승객
  const sec1=document.createElement('div');
  sec1.innerHTML=`<div class="res-section-title" style="margin-bottom:8px">${st.name}역에서 내린 승객</div>`;
  const cards=document.createElement('div'); cards.className='answer-cards';
  [...correct].forEach(pid=>{
    const p=PERSONS.find(x=>x.id===pid);
    const isSel=selArr.includes(pid);
    const card=document.createElement('div'); card.className='answer-card';
    card.style.borderColor=isSel?'#c8e6c9':'#ffe0b2';
    card.innerHTML=`
      <img class="ac-img" src="${BASE}${p.front}${V}" alt="${p.name}">
      <div class="ac-info">
        <div class="ac-name">${p.name}</div>
        <div class="ac-reason">${p.desc}</div>
        <span class="ac-badge ${isSel?'ok':'miss'}">${isSel?'✓ 맞힘':'놓침'}</span>
      </div>
    `;
    cards.appendChild(card);
  });
  sec1.appendChild(cards);
  body.appendChild(sec1);

  // 오선택
  const wrongPersons=selArr.filter(id=>!correct.has(id)).map(id=>PERSONS.find(p=>p.id===id));
  if(wrongPersons.length>0){
    const wsec=document.createElement('div'); wsec.className='wrong-section';
    wsec.innerHTML=`<div class="wrong-title">잘못 선택한 승객</div>`;
    wrongPersons.forEach(p=>{
      const item=document.createElement('div'); item.className='wrong-item';
      item.innerHTML=`
        <img class="wrong-img" src="${BASE}${p.front}${V}" alt="${p.name}">
        <div>
          <div class="wrong-name">${p.name} <span style="color:#ef4444;font-size:10px">✗ 오선택</span></div>
          <div class="wrong-reason">${st.name}역에서 내리지 않아요.</div>
        </div>
      `;
      wsec.appendChild(item);
    });
    body.appendChild(wsec);
  }

  // 다음 버튼
  const btn=$('res-next');
  const ni=gameIdx+1;
  if(ok){btn.textContent='오늘 등교 완료!';btn.className='res-next green';btn.onclick=showEnd;}
  else if(ni<STATIONS.length){btn.textContent=STATIONS[ni].name+'역으로 이동';btn.className='res-next brown';btn.onclick=()=>startRound(ni);}
  else{btn.textContent='결과 보기';btn.className='res-next brown';btn.onclick=showEnd;}

  showScreen('sc-result');
}

// 종료
const ROUTE_TO_SEOKGYE = {
  '합정':23,'상수':22,'대흥':20,'공덕':18,
  '삼각지':16,'이태원':14,'신당':9,'월곡':4,'상월곡':3
};

function showEnd(){
  let seatedStations=0;
  let firstSeat='없음';
  let tried=Object.keys(stationResults).length;
  for(let i=0;i<STATIONS.length;i++){
    if(stationResults[STATIONS[i].name]==='success'){
      seatedStations=ROUTE_TO_SEOKGYE[STATIONS[i].name]||0;
      firstSeat=STATIONS[i].name+'역';
      break;
    }
  }
  $('end-num').textContent=seatedStations;
  let comment='';
  let type='';
  if(seatedStations>=20){comment='오늘 하루 개운하게 시작!<br>완벽한 등굣길이었어요.';type='초반 선점형';}
  else if(seatedStations>=14){comment='그래도 운 좋은 하루.<br>절반 이상은 앉아서 왔네요.';type='균형 관찰형';}
  else if(seatedStations>=6){comment='다리 마사지 필수.<br>오늘 꽤 서서 왔군요.';type='후반 회복형';}
  else{comment='내일은 일찍 출발해요.<br>오늘은 거의 서서 왔어요.';type='단서 재검토형';}
  $('end-comment').innerHTML=`
    ${comment}
    <div class="end-report">
      <div class="end-report-row"><span>첫 자리 확보</span><b>${firstSeat}</b></div>
      <div class="end-report-row"><span>관찰 성향</span><b>${type}</b></div>
      <div class="end-report-row"><span>확인한 역</span><b>${tried}개 역</b></div>
    </div>
  `;
  showScreen('sc-end');
}

$('end-restart').addEventListener('click',()=>{
  wins=0;
  firstFail='';
  cbDone=false;
  gameIdx=0;
  selected.clear();
  Object.keys(stationResults).forEach(k=>delete stationResults[k]);

  $('tag-reader').classList.remove('ready');
  $('climate-card').classList.remove('tagged','dragging');
  const msg=$('tag-reader').querySelector('.tag-sound-msg');
  if(msg) msg.remove();

  $('cb-overlay').classList.remove('gone');
  $('doors').classList.remove('open');

  setHeader(true);
  showScreen('sc-start');

  requestAnimationFrame(()=>resetCard(false));
});

setHeader(true);
</script>
</body>
