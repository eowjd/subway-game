const climateCard=$('climate-card');
const dragStage=$('drag-stage');
const tagReader=$('tag-reader');
let dragState=null;

function cardOrigin(){
  const stage=dragStage.getBoundingClientRect();
  const cardW=climateCard.offsetWidth || 250;
  const cardH=climateCard.offsetHeight || 160;
  return {
    x: stage.width - cardW - 82,
    y: stage.height - cardH - 48
  };
}
function setCardPos(x,y){
  climateCard.style.left = x + 'px';
  climateCard.style.top = y + 'px';
}
function resetCard(animated=true){
  const o=cardOrigin();
  if(animated) climateCard.style.transition='left .24s ease, top .24s ease';
  setCardPos(o.x,o.y);
  setTimeout(()=>{ if(!dragState) climateCard.style.transition='box-shadow .18s, transform .18s'; },260);
}
function isOverReader(){
  const cardRect = climateCard.getBoundingClientRect();
  const readerRect = tagReader.getBoundingClientRect();
  const cardCx = cardRect.left + cardRect.width/2;
  const cardCy = cardRect.top + cardRect.height/2;
  const readerCx = readerRect.left + readerRect.width/2;
  const readerCy = readerRect.top + readerRect.height/2;
  const dx = cardCx - readerCx;
  const dy = cardCy - readerCy;
  return Math.sqrt(dx*dx + dy*dy) < 210;
}
function snapToReaderAndStart(){
  if(cbDone) return;
  const stageRect = dragStage.getBoundingClientRect();
  const readerRect = tagReader.getBoundingClientRect();
  const x = readerRect.left - stageRect.left + (readerRect.width - climateCard.offsetWidth)/2;
  const y = readerRect.top - stageRect.top + (readerRect.height - climateCard.offsetHeight)/2;
  climateCard.style.transition='left .2s ease, top .2s ease, transform .18s ease';
  setCardPos(x,y);
  climateCard.classList.add('tagged');
  tagReader.classList.add('ready');
  playTagSound();
  onCheck();
}

function startDrag(clientX, clientY){
  if(cbDone) return;
  const stageRect = dragStage.getBoundingClientRect();
  const cardRect = climateCard.getBoundingClientRect();
  dragState = { dx: clientX - cardRect.left, dy: clientY - cardRect.top, stageRect };
  climateCard.classList.add('dragging');
  climateCard.style.transition='none';
}
function moveDrag(clientX, clientY){
  if(!dragState || cbDone) return;
  const stageRect = dragState.stageRect;
  let x = clientX - stageRect.left - dragState.dx;
  let y = clientY - stageRect.top - dragState.dy;
  const maxX = stageRect.width - climateCard.offsetWidth;
  const maxY = stageRect.height - climateCard.offsetHeight;
  x = Math.max(0, Math.min(maxX, x));
  y = Math.max(0, Math.min(maxY, y));
  setCardPos(x,y);
  tagReader.classList.toggle('ready', isOverReader());
}
function endDrag(){
  if(!dragState || cbDone) return;
  climateCard.classList.remove('dragging');
  const over = isOverReader();
  dragState = null;
  if(over) snapToReaderAndStart();
  else{
    tagReader.classList.remove('ready');
    climateCard.classList.remove('tagged');
    resetCard(true);
  }
}

climateCard.addEventListener('pointerdown', e=>{
  e.preventDefault();
  startDrag(e.clientX, e.clientY);
});
document.addEventListener('pointermove', e=> moveDrag(e.clientX, e.clientY));
document.addEventListener('pointerup', ()=> endDrag());
document.addEventListener('pointercancel', ()=> endDrag());
window.addEventListener('load', ()=> resetCard(false));
window.addEventListener('resize', ()=> { if(!dragState && !cbDone) resetCard(false); });

tagReader.addEventListener('click',()=>{
  if(cbDone) return;
  snapToReaderAndStart();
});


