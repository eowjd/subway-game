<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>등굣길 자리잡기</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/neodgm/neodgm-pro@latest/neodgm/style.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{width:100%;height:100%;min-height:100dvh;overflow:hidden;background:#0a0a0a;font-family:'Inter',sans-serif;display:flex;justify-content:center;align-items:center}
#app{width:min(100vw,1440px);height:100dvh;max-width:1440px;display:flex;flex-direction:column;overflow:hidden;flex-shrink:0}

/* ══ 헤더 ══ */
.header{flex-shrink:0;background:#050508;border-bottom:2px solid #1a0800;position:relative;overflow:hidden}

/* 탑승 전 */
.hdr-boarding{display:flex;flex-direction:column;transition:opacity .4s,transform .4s}
.hdr-boarding.hide{opacity:0;pointer-events:none;position:absolute;inset:0;transform:translateY(-8px)}

.hb-route{padding:14px 48px 10px;display:flex;align-items:center;justify-content:center;gap:0}
.hb-st{display:flex;flex-direction:column;align-items:center;gap:2px;opacity:.35;flex-shrink:0}
.hb-st.now{opacity:1}
.hb-ko{font-family:'Inter',sans-serif;font-size:16px;font-weight:500;color:#777}
.hb-st.now .hb-ko{font-size:36px;font-weight:700;color:#fff;letter-spacing:-.03em}
.hb-en{font-family:'Inter',sans-serif;font-size:10px;color:#444}
.hb-st.now .hb-en{font-size:11px;color:#666}
.hb-seg{width:56px;height:1px;background:#222;margin:0 14px;flex-shrink:0;align-self:flex-start;margin-top:20px}
.hb-arr{color:#f59e0b;font-size:13px;flex-shrink:0;align-self:flex-start;margin-top:19px;margin:19px 4px 0}

/* 게임 중 */
.hdr-game{display:flex;flex-direction:column;opacity:0;pointer-events:none;position:absolute;inset:0;transition:opacity .4s;overflow:hidden}
.hdr-game.show{opacity:1;pointer-events:all;position:relative}
.hg-inner{padding:10px 0 6px;display:flex;flex-direction:column;align-items:center;gap:2px}
.hg-row1{display:flex;align-items:baseline;gap:10px;justify-content:center}
.hg-lbl{font-family:'NeoDunggeunmo',monospace;font-size:16px;color:#39ff85;opacity:.7;letter-spacing:.04em}
.hg-st{font-family:'NeoDunggeunmo',monospace;font-size:30px;color:#39ff85;letter-spacing:.06em;text-shadow:0 0 10px rgba(57,255,133,.4);line-height:1}
.hg-row2{display:flex;align-items:center;gap:8px;justify-content:center}
.hg-arr{font-family:'NeoDunggeunmo',monospace;font-size:22px;color:#ff4444}
.hg-door{font-family:'NeoDunggeunmo',monospace;font-size:22px;color:#39ff85;letter-spacing:.05em}

/* 배너 공통 */
.ticker-bar{height:44px;background:#030306;border-top:1px solid #0e0e14;overflow:hidden;display:flex;align-items:center;flex-shrink:0}
.ticker-inner{white-space:nowrap;animation:tk 36s linear infinite;padding-left:100vw;font-family:'NeoDunggeunmo',monospace;font-size:20px;color:#f59e0b;letter-spacing:.06em}
@keyframes tk{to{transform:translateX(-100%)}}

/* ══ 메인 ══ */
.main{flex:1;min-height:0;position:relative;overflow:hidden}
.screen{position:absolute;inset:0;display:flex;min-height:0;opacity:0;pointer-events:none;transition:opacity .35s}
.screen.on{opacity:1;pointer-events:all}

/* ── 탑승 ── */
#sc-start{background:#1a1a1a}
.door-container{width:100%;height:100%;display:flex;position:relative;overflow:hidden}
.door-bg{position:absolute;inset:0;background:#1e1e1e}
.door-panel{height:100%;position:relative;z-index:2;overflow:hidden;transition:transform .95s cubic-bezier(.4,0,.2,1);width:50%}
.door-l{background:linear-gradient(180deg,#6e6e6e 0%,#666 44%,#575757 45%,#606060 60%,#666 100%);border-right:4px solid #4e4e4e;transform:translateX(0)}
.door-r{background:linear-gradient(180deg,#6e6e6e 0%,#666 44%,#575757 45%,#606060 60%,#666 100%);border-left:4px solid #4e4e4e;transform:translateX(0)}
.door-top-bar{position:absolute;top:0;left:0;right:0;height:24px;background:#111;border-bottom:2px solid #0a0a0a;z-index:3}
.door-bot-bar{position:absolute;bottom:0;left:0;right:0;height:18px;background:#111;border-top:2px solid #0a0a0a;z-index:3}
.handle{position:absolute;top:50%;transform:translateY(-50%);width:6px;height:52px;background:#888;border-radius:3px}
.door-l .handle{right:14px}
.door-r .handle{left:14px}
.door-container.open .door-l{transform:translateX(-100%)}
.door-container.open .door-r{transform:translateX(100%)}
.cb-overlay{position:absolute;inset:0;z-index:10;display:flex;align-items:center;justify-content:center;transition:opacity .3s}
.cb-overlay.gone{opacity:0;pointer-events:none}
.cb-card{background:#fff;border-radius:16px;padding:20px 30px;display:flex;align-items:center;gap:16px;box-shadow:0 12px 48px rgba(0,0,0,.5);cursor:pointer;user-select:none;transition:transform .12s}
.cb-card:active{transform:scale(.97)}
.cb-box{width:34px;height:34px;border:2.5px solid #ccc;border-radius:5px;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:#fff;transition:border-color .18s}
.cb-box.on{border-color:#2563eb}
.cb-svg{opacity:0;transform:scale(.4) rotate(-15deg);transition:opacity .18s,transform .25s cubic-bezier(.34,1.6,.64,1)}
.cb-box.on .cb-svg{opacity:1;transform:scale(1) rotate(0)}
.cb-lbl{font-family:'NeoDunggeunmo',monospace;font-size:22px;color:#1a1a1a;white-space:nowrap}

/* ── 관찰 ── */
#sc-obs{flex-direction:column;min-height:0;overflow:hidden}
.obs-prompt{flex-shrink:0;height:46px;background:#fff;border-bottom:.5px solid #e0d8cc;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 10px rgba(0,0,0,.08);z-index:5}
.obs-pt{font-family:'Inter',sans-serif;font-size:16px;color:#555;font-weight:500;letter-spacing:-.02em}
.obs-pt b{color:#894331;font-weight:800;font-size:18px}


/* 호버 피드백: 사진을 가리지 않고 상단 안내문만 반응 */
.obs-prompt.peek-mode{
  background:#fff8f0;
}
.obs-prompt.peek-mode .obs-pt{
  color:#5f4b3f;
}

/* 지하철 씬 */
.subway-scene{
  flex:1;
  position:relative;
  overflow:hidden;
  min-height:0;
  background:#1e1e1e;
}

/* 배경 레이어 — 좌석/통로 구조만 */
.seat-bg{
  position:absolute;
  inset:0;
  display:flex;
  flex-direction:column;
  pointer-events:none;
}
.backrest-top{height:48px;flex-shrink:0;background:#4A6A8F;box-shadow:inset 0 4px 34px rgba(0,0,0,0.5)}
.seat-surface-top{height:132px;flex-shrink:0;background:#4A6A8F;box-shadow:inset 0 4px 12px rgba(0,0,0,0.42)}
.aisle-bg{flex:1;background-color:#8e9496;background-image:url('subway_floor_texture.jpg');background-repeat:repeat;background-size:420px auto;background-position:center;box-shadow:inset 0 10px 24px rgba(0,0,0,.18), inset 0 -10px 24px rgba(0,0,0,.16)}
.seat-surface-bottom{height:132px;flex-shrink:0;background:#4A6A8F;box-shadow:inset 0 -4px 12px rgba(0,0,0,0.42)}
.backrest-bottom{height:48px;flex-shrink:0;background:#4A6A8F;box-shadow:inset 0 -4px 34px rgba(0,0,0,0.5)}

/* 인물 레이어 — 씬 전체 덮음 */
.pax-layer{
  position:absolute;
  inset:0;
  display:grid;
  grid-template-rows:1fr 1fr;
  grid-template-columns:1fr;
  min-height:0;
}


.pax-row-top{
  display:grid;
  grid-template-columns:repeat(4,minmax(180px,230px));
  justify-content:center;
  column-gap:8px;
  align-items:flex-end; /* 인물 하단 정렬 → 엉덩이 쪽으로 */
  position:relative;
  overflow:visible;
  z-index:2;
}
.pax-row-bottom{
  display:grid;
  grid-template-columns:repeat(4,minmax(180px,230px));
  justify-content:center;
  column-gap:8px;
  align-items:flex-start; /* 인물 상단 정렬 → 뒤집혀서 머리가 아래 */
  position:relative;
  overflow:visible;
}

/* 인물 슬롯 */
.pax-slot{
  position:relative;
  display:flex;
  align-items:flex-end;
  justify-content:center;
  cursor:pointer;
  overflow:visible;
  height:100%;
}
.pax-slot:hover{z-index:30}
.pax-slot.selected::after{content:'';position:absolute;inset:0;border:3px solid #894331;pointer-events:none;z-index:5}

/* 탑뷰 */
.img-top{
  position:absolute;
  bottom:0;
  width:auto;
  height:clamp(235px,39dvh,420px);
  max-height:calc(100% - 10px);
  max-width:96%;
  object-fit:contain;
  object-position:bottom center;
  pointer-events:none;
  user-select:none;
  transition:opacity .2s;
  left:50%;
  transform:translateX(-50%);
}

/* 정면뷰 */
.img-front{
  position:absolute;
  bottom:0;
  width:auto;
  height:clamp(235px,39dvh,420px);
  max-height:calc(100% - 10px);
  max-width:96%;
  object-fit:contain;
  object-position:bottom center;
  pointer-events:none;
  user-select:none;
  opacity:0;
  transition:opacity .2s;
  z-index:20;
  left:50%;
  transform:translateX(-50%);
  filter:drop-shadow(0 8px 24px rgba(0,0,0,.4));
}

/* 호버 */
.pax-slot:hover .img-top{opacity:0}
.pax-slot:hover .img-front{opacity:1}

/* 아랫줄: 탑뷰만 180도 */
.pax-row-bottom .img-top{
  bottom:auto;
  top:0;
  object-position:top center;
  transform:translateX(-50%) rotate(180deg);
}
.pax-row-bottom .img-front{
  bottom:auto;
  top:0;
  object-position:top center;
  transform:translateX(-50%);
}
.pax-row-bottom .pax-slot{align-items:flex-start}


/* 개별 인물 크기 보정: 직장인 여성3 */
.pax-slot[data-id="worker_f03"] .img-top{
  height:clamp(270px,43dvh,470px);
}
.pax-slot[data-id="worker_f03"] .img-front{
  height:clamp(250px,41dvh,445px);
}


/* 개별 인물 크기 보정: 직장인 여성3 탑뷰 체감 확대 */
.pax-slot[data-id="worker_f03"] .img-top{
  transform:translateX(-50%) scale(1.18);
  transform-origin:center center;
}
.pax-row-bottom .pax-slot[data-id="worker_f03"] .img-top{
  transform:translateX(-50%) rotate(180deg) scale(1.18);
  transform-origin:center center;
}


/* 아랫줄 호버 정면뷰 보정: 얼굴 가림 방지 */
.pax-row-bottom .pax-slot:hover{
  z-index:60;
}
.pax-row-bottom .img-front{
  top:52px;
  z-index:70;
  object-position:top center;
}
.pax-row-bottom .pax-slot:hover .img-front{
  opacity:1;
}
/* 선택 뱃지 */
.sel-badge{position:absolute;top:8px;right:8px;width:22px;height:22px;border-radius:50%;background:#894331;z-index:10;display:none;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(137,67,49,.6)}
.pax-slot.selected .sel-badge{display:flex}
.sel-badge svg{width:12px;height:12px;fill:#fff}

/* 푸터 */
.obs-footer{flex-shrink:0;height:52px;background:#fff;border-top:.5px solid #e0d8cc;display:flex;align-items:center;padding:0 24px;justify-content:flex-end}
.obs-btn{height:40px;padding:0 26px;border-radius:10px;border:none;background:#e0d8cc;color:#aaa;font-family:'NeoDunggeunmo',monospace;font-size:14px;cursor:not-allowed;white-space:nowrap;transition:all .18s}
.obs-btn.on{background:#894331;color:#fff;cursor:pointer}
.obs-btn.on:active{transform:scale(.97)}

/* ── 결과 ── */
#sc-result{flex-direction:column;background:#f4f0ea}
.res-header{flex-shrink:0;padding:22px 32px;display:flex;align-items:flex-start;gap:18px;background:#fff;border-bottom:.5px solid #e0d8cc}
.res-icon{width:46px;height:46px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.res-icon svg{width:24px;height:24px}
.res-texts{flex:1;display:flex;flex-direction:column;align-items:flex-start}
.res-title{font-family:'NeoDunggeunmo',monospace;font-size:24px;line-height:1.15;margin-bottom:6px}
.res-sub{font-family:'Inter',sans-serif;font-size:13px;color:#8f8f8f;font-weight:400;margin-bottom:14px}
.res-nums{display:flex;gap:18px;flex-wrap:wrap}
.rn{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;min-width:68px;padding:8px 10px;border-radius:10px;background:rgba(255,255,255,.55);border:.5px solid #e7dacf}
.rn-v{font-family:'NeoDunggeunmo',monospace;font-size:30px;font-weight:700;line-height:1}
.rn-l{font-family:'Inter',sans-serif;font-size:11px;color:#9a9a9a;font-weight:600}
.res-body{flex:1;overflow-y:auto;padding:24px 32px 32px;display:flex;flex-direction:column;gap:20px}
.station-card{background:#fff;border-radius:14px;padding:20px 22px;border:.5px solid #e0d8cc}
.station-name{font-family:'NeoDunggeunmo',monospace;font-size:20px;color:#894331;margin-bottom:10px}
.station-desc{font-family:'Inter',sans-serif;font-size:16px;color:#666;font-weight:400;line-height:1.8}
.res-section-title{font-family:'Inter',sans-serif;font-size:12px;font-weight:700;color:#9c9c9c;letter-spacing:.08em;text-transform:uppercase}
.answer-cards{display:flex;gap:14px;flex-wrap:wrap}
.answer-card{display:flex;align-items:center;gap:16px;background:#fff;border-radius:14px;padding:18px 18px;border:.5px solid #e0d8cc;flex:1;min-width:280px}
.ac-img{width:72px;height:96px;object-fit:contain;object-position:bottom center;flex-shrink:0}
.ac-info{flex:1}
.ac-name{font-family:'Inter',sans-serif;font-size:19px;font-weight:700;color:#1a1a1a;margin-bottom:6px}
.ac-reason{font-family:'Inter',sans-serif;font-size:15px;color:#777;font-weight:400;line-height:1.7}
.ac-badge{font-size:12px;font-weight:700;padding:4px 10px;border-radius:20px;display:inline-block;margin-top:8px}
.ac-badge.ok{background:#e8f5e9;color:#2e7d32}
.ac-badge.miss{background:#fff3e0;color:#e65100}
.wrong-section{background:#fff8f7;border-radius:14px;padding:18px 20px;border:.5px solid #ffd5d0}
.wrong-title{font-family:'Inter',sans-serif;font-size:12px;font-weight:700;color:#ef4444;letter-spacing:.06em;text-transform:uppercase;margin-bottom:12px}
.wrong-item{display:flex;align-items:center;gap:14px;padding:10px 0;border-bottom:.5px solid #ffe0de}
.wrong-item:last-child{border-bottom:none}
.wrong-img{width:56px;height:74px;object-fit:contain;object-position:bottom center;opacity:.55}
.wrong-name{font-family:'Inter',sans-serif;font-size:17px;font-weight:600;color:#555}
.wrong-reason{font-family:'Inter',sans-serif;font-size:14px;color:#9a9a9a;font-weight:400;margin-top:4px}
.res-footer{flex-shrink:0;height:52px;background:#fff;border-top:.5px solid #e0d8cc;display:flex;align-items:center;padding:0 24px;justify-content:flex-end}
.res-next{height:40px;padding:0 24px;border-radius:10px;border:none;font-family:'NeoDunggeunmo',monospace;font-size:14px;cursor:pointer;white-space:nowrap;transition:all .15s}
.res-next.brown{background:#894331;color:#fff}
.res-next.green{background:#22c55e;color:#000}
.res-next:active{transform:scale(.97)}

/* ── 종료 ── */
#sc-end{background:linear-gradient(180deg,#111 0%,#1e1e1e 100%);flex-direction:column;align-items:center;justify-content:center;padding:0 0 170px;text-align:center;position:relative;overflow:hidden}
#sc-end::before{content:'';position:absolute;top:-10%;left:50%;transform:translateX(-50%);width:700px;height:700px;border-radius:50%;background:radial-gradient(ellipse,rgba(255,220,120,.08) 0%,transparent 65%);pointer-events:none}
.end-exit-sign{font-family:'NeoDunggeunmo',monospace;font-size:15px;color:#f59e0b;letter-spacing:.22em;opacity:.68;margin-bottom:30px}
.end-label{font-family:'Inter',sans-serif;font-size:14px;color:#666;letter-spacing:.12em;text-transform:uppercase;margin-bottom:14px;font-weight:500}
.end-today{font-family:'Inter',sans-serif;font-size:20px;color:#d6d6d6;margin-bottom:14px;font-weight:800;letter-spacing:-.02em}
.end-score-wrap{display:flex;align-items:baseline;gap:6px;justify-content:center;margin-bottom:6px}
.end-score-num{font-family:'NeoDunggeunmo',monospace;font-size:96px;color:#fff;line-height:1;letter-spacing:-.02em;text-shadow:0 0 40px rgba(255,255,255,.12)}
.end-score-denom{font-family:'NeoDunggeunmo',monospace;font-size:40px;color:#333}
.end-div{width:48px;height:1px;background:#2a2a2a;margin:28px auto}
.end-comment{font-family:'NeoDunggeunmo',monospace;font-size:20px;color:#ccc;line-height:1.6;margin-bottom:0;max-width:500px;letter-spacing:.02em}
.end-restart{position:absolute;left:50%;bottom:34px;transform:translateX(-50%);height:58px;padding:0 48px;border-radius:14px;border:1px solid #3a3a3a;background:rgba(0,0,0,.36);color:#888;font-family:'NeoDunggeunmo',monospace;font-size:18px;cursor:pointer;transition:all .2s;z-index:2;box-shadow:0 12px 32px rgba(0,0,0,.28)}
.end-restart:hover{border-color:#894331;color:#894331;background:rgba(0,0,0,.48)}
.end-restart:active{transform:translateX(-50%) scale(.98)}


@media (max-width: 900px){
  .pax-row-top,
  .pax-row-bottom{
    grid-template-columns:repeat(4,minmax(120px,1fr));
    column-gap:0;
  }

  .hb-route{padding:10px 16px 8px}
  .hb-st:not(.now){display:none}
  .hb-seg,.hb-arr{display:none}
  .hb-st.now .hb-ko{font-size:28px}
  .ticker-inner{font-size:16px}
  .hg-st{font-size:26px}
  .hg-door,.hg-arr{font-size:18px}
}

/* ── v14 디자인 정리: 관찰 가이드북 톤 강화 ── */
.intro-card{
  width:min(520px,88vw);
  min-height:300px;
  flex-direction:column;
  align-items:flex-start;
  justify-content:center;
  gap:0;
  padding:36px 42px;
  background:linear-gradient(180deg,#fffaf3 0%,#f2e8db 100%);
  border:1px solid rgba(137,67,49,.22);
  border-radius:24px;
  box-shadow:0 24px 80px rgba(0,0,0,.58);
}
.intro-kicker{
  font-size:13px;
  font-weight:800;
  color:#894331;
  letter-spacing:.12em;
  margin-bottom:14px;
}
.intro-title{
  font-size:44px;
  line-height:1.05;
  font-weight:900;
  color:#171717;
  letter-spacing:-.05em;
  margin-bottom:18px;
}
.intro-desc{
  font-size:16px;
  line-height:1.75;
  color:#5e5a55;
  font-weight:500;
  margin-bottom:28px;
}
.intro-action{
  display:flex;
  align-items:center;
  gap:14px;
  padding:14px 18px;
  border-radius:16px;
  background:#111;
  color:#fff;
  box-shadow:0 10px 28px rgba(0,0,0,.18);
}
.intro-action .cb-lbl{color:#fff;font-size:18px}
.intro-tag-icon{border-color:#894331;background:#f4f0ea}
.intro-hint{
  margin-top:18px;
  font-size:11px;
  color:#8a8177;
  letter-spacing:.08em;
  text-transform:uppercase;
}

.intro-board{
  width:100%;
  margin:0 0 6px;
}
.drag-stage{
  position:relative;
  width:100%;
  height:190px;
  border-radius:22px;
  background:linear-gradient(180deg,#f7efe5 0%,#ede0d1 100%);
  border:1px dashed rgba(137,67,49,.18);
  overflow:hidden;
}
.tag-reader{
  position:absolute;
  left:28px;
  top:50%;
  transform:translateY(-50%);
  width:140px;
  height:140px;
  border-radius:24px;
  background:linear-gradient(180deg,#111 0%,#252525 100%);
  box-shadow:0 16px 34px rgba(0,0,0,.28);
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  color:#fff;
  gap:8px;
}
.tag-reader-top{
  font-size:10px;
  letter-spacing:.18em;
  color:#a5a5a5;
  font-weight:700;
}
.tag-reader-ring{
  width:58px;
  height:58px;
  border-radius:50%;
  border:2px solid rgba(255,255,255,.82);
  box-shadow:0 0 0 10px rgba(255,255,255,.06), inset 0 0 20px rgba(255,255,255,.08);
}
.tag-reader-bottom{
